{
  "name": "@databuilder/tracking-script",
  "version": "1.0.0",
  "description": "databuilder JS tracking snippet",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "esbuild src/tracker.js --bundle --minify --format=iife --outfile=dist/t.js && node -e \"const s=require('fs').statSync('dist/t.js').size;console.log('t.js size:',(s/1024).toFixed(2),'KB');if(s>5120){console.error('ERROR: exceeds 5KB');process.exit(1)}\""
  },
  "devDependencies": {
    "esbuild": "^0.20.2"
  }
}
